FROM node:22.22.2-alpine3.23@sha256:cb15fca92530d7ac113467696cf1001208dac49c3c64355fd1348c11a88ddf8f
COPY bootstrap/initialize.mjs /initialize.mjs
COPY bootstrap/configure-provider.mjs /configure-provider.mjs
COPY bootstrap/configure-spotify-mode.mjs /configure-spotify-mode.mjs
COPY bootstrap/configure-youtube-dial.mjs /configure-youtube-dial.mjs
COPY bootstrap/launch-gateway.sh bootstrap/spotify.yml /assets/
COPY --from=assets /mediamtx.yml /assets/mediamtx.yml
COPY --from=assets /probes /assets/probes
COPY LICENSE NOTICE /usr/share/doc/zombiebox/
ENTRYPOINT ["node", "/initialize.mjs"]
